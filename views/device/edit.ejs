    <script>
        $(document).ready(function () {

            const socket = io()
            const username = "<%= session.botPhoneNumber %>"
            socket.emit('join_wa_room', username)
            let checking = false
            let lastSessionState = null // 'CONNECTED' | 'DISCONNECTED' | 'PAIRING'
            let pendingTimer = null

            if (!username) {
                alert("Username tidak ditemukan")
                return
            }

            // =========================
            // HELPER
            // =========================
            function log(msg) {
                $("#logTableBody").prepend(
                    $("<tr>").append($("<td>").text(msg))
                )
            }

            function resetUI() {
                // $("#qrcode").hide().attr("src", "")
                $("#PairingCode").hide().empty()

                $("#waInfo").html(`
                <img src="https://cdn-icons-png.flaticon.com/128/3135/3135715.png" alt=""
                                            class="flex-shrink-0 me-12 w-40-px h-40-px rounded-circle me-12">
                                        <div class="flex-grow-1">
                                            <h6 class="text-md mb-0">Belum terhubung</h6>
                                            <span
                                                class="text-sm text-secondary-light fw-normal">Silakan mulai sesi</span>
                                        </div>
                `)

                $("#startWhatsapp").show()
                $("#deleteSession, #restartSession").hide()

                $("#SesiAda").hide()
                $("#chooseMethod").show()
                // $("#NotSesi").show()
            }
            function startPendingTimeout() {
                if (pendingTimer) clearTimeout(pendingTimer)

                pendingTimer = setTimeout(() => {
                    log("⌛ Timeout: sesi tidak diselesaikan, dibatalkan")
                    socket.emit("cancel_pending_session", username)
                    resetUI()
                }, 120000) // 60 detik
            }


            // =========================
            // CHECK SESSION ON LOAD
            // =========================
            function checkSession() {
                if (checking) return
                checking = true
                socket.emit("check_session", username)
                setTimeout(() => checking = false, 1000)
            }

            checkSession()
            // =========================
            // RESET SESSION SAAT GANTI METODE LOGIN
            // =========================
            $("#loginMethod").on("change", function () {
                log("🔄 Metode login diganti, reset sesi pending")

                socket.emit("cancel_pending_session", username)

                // bersihkan UI lokal
                $("#qrcode").hide().attr("src", "")
                $("#PairingCode").hide().empty()

                lastSessionState = null
            })
            // auto check tiap 5 detik
            // setInterval(checkSession, 5000)
            socket.on("session_exists", () => setStatus("CONNECTED"))
            socket.on("wa:pairing-code", () => setStatus("PAIRING"))
            socket.on("session_not_exists", () => setStatus("DISCONNECTED"))
            socket.on("session_deleted", () => setStatus("DISCONNECTED"))

            socket.on("session_exists", function (info) {
                lastSessionState = 'CONNECTED'
                $("#NotSesi, #PairingCode, #qrcode").hide()

                $("#waInfo").html(`
                <img src="${info.profilePicUrl}" alt="" class="flex-shrink-0 me-12 w-40-px h-40-px rounded-circle me-12">
                                        <div class="flex-grow-1">
                                            <h6 class="text-md mb-0">${info.pushname}</h6>
                                            <span
                                                class="text-sm text-secondary-light fw-normal">${info.wid}</span>
                                        </div>
                `)

                $("#startWhatsapp").hide()
                $("#deleteSession, #restartSession").show()

                log("Sesi WhatsApp aktif")
                $('#chooseMethod').hide();
            })

            socket.on("session_not_exists", function () {
                if (lastSessionState !== 'DISCONNECTED') {
                    log("Belum ada sesi WhatsApp")
                    lastSessionState = 'DISCONNECTED'
                }
                resetUI()
            })


            // =========================
            // START SESSION
            // =========================
            $("#startWhatsapp").on("click", function () {
                const method = $("#loginMethod").val()

                socket.emit("wa:start", {
                    username,
                    method,
                    phone: $("#pairingPhone").val() || null
                })

                log(`Memulai sesi WhatsApp ${method}...`)
            })

            // =========================
            // QR
            // =========================
            socket.on("wa:qr", function (qr) {
                // startPendingTimeout()
                $("#NotSesi").show()
                $("#qrcode").show()
                    .attr("src",
                        "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=" +
                        encodeURIComponent(qr)
                    )
                log("QR Code diterima")
            })

            // =========================
            // PAIRING
            // =========================
            socket.on("wa:pairing-code", function (code) {
                startPendingTimeout()
                $("#NotSesi").hide()
                $("#qrcode").hide()

                $("#PairingCode").show().html(`
                <div class="alert alert-success bg-success-100 text-success-600 border-success-100 mb-0 fw-semibold text-lg radius-8">
                        <div class="text-center">
                            <h5 class="text-success fw-bold">Pairing Code</h5>
                            <span class="bg-success-600 radius-4 px-24">
                                <h2 class="text-white">${code}</h2>
                            </span>
                            <p> WhatsApp > Perangkat Tertaut > Tautkan Perangkat </p>
                        </div>
                    </div> `)

                log("Pairing code dikirim")
            })

            // =========================
            // READY
            // =========================
            socket.on("wa:ready", function (info) {
                if (pendingTimer) {
                    clearTimeout(pendingTimer)
                    pendingTimer = null
                }
                log("WhatsApp berhasil terhubung")
                checkSession()
            })

            // =========================
            // DELETE SESSION
            // =========================
            $("#deleteSession").on("click", function () {
                new bootstrap.Modal("#confirmDeleteModal").show()
            })

            $("#confirmDeleteBtn").on("click", function () {
                socket.emit("delete_session", username)
                bootstrap.Modal.getInstance(
                    document.getElementById("confirmDeleteModal")
                ).hide()
                log("🧹 Menghapus sesi…")
            })


            socket.on("session_deleted", function () {
                log("Sesi dihapus total")
                resetUI()
            })

            // =========================
            // RESTART SESSION
            // =========================
            $("#restartSession").on("click", function () {
                log("Merestart sesi WhatsApp...")
                socket.emit("restart_session", username)
            })

            socket.on("session_restarted", function () {
                log("Restart berhasil, menunggu koneksi ulang...")
                resetUI()
            })

            // =========================
            // ERROR
            // =========================
            socket.on("error", function (err) {
                log("Error: " + err)
            })
            function setStatus(status) {
                const badge = $("#waStatusBadge")

                badge.removeClass("bg-success bg-warning bg-danger bg-secondary")

                if (status === "CONNECTED") {
                    badge.addClass("bg-success").text("CONNECTED")
                } else if (status === "PAIRING") {
                    badge.addClass("bg-warning").text("PAIRING")
                } else {
                    badge.addClass("bg-danger").text("DISCONNECTED")
                }
            }


            $("#btnSendMessage").on("click", function () {
                const to = $("#sendTo").val().trim()
                const message = $("#sendMessage").val().trim()

                if (!to || !message) {
                    $("#sendStatus").html(
                        `<span class="text-danger">Nomor & pesan wajib diisi</span>`
                    )
                    return
                }

                socket.emit("wa:send-message", {
                    username,
                    to,
                    message
                })

                $("#sendStatus").html(
                    `<span class="text-secondary">⏳ Mengirim pesan...</span>`
                )
            })

            // response sukses
            socket.on("wa:message-sent", () => {
                $("#sendStatus").html(
                    `<span class="text-success">✅ Pesan terkirim</span>`
                )
                log(`✅ Pesan terkirim`)
                $("#sendMessage").val("")
            })

            // response gagal
            socket.on("wa:message-failed", (err) => {
                $("#sendStatus").html(
                    `<span class="text-danger">❌ Gagal: ${err}</span>`
                )
            })
            $("#saveWebhookBtn").click(function () {
                const personalWebhookUrl = $('#personalWebhookUrl').val();
                const groupWebhookUrl = $('#groupWebhookUrl').val();

                if (!personalWebhookUrl || !groupWebhookUrl) {
                    alert("URL Webhook tidak boleh kosong!");
                    return;
                }

                if (!username) {
                    alert("Username/Phone Number tidak ditemukan!");
                    return;
                }

                const data = {
                    phoneNumber: username,  // Use the correct phone number or username value
                    personalWebhookUrl: personalWebhookUrl,
                    groupWebhookUrl: groupWebhookUrl,
                    act: 'saveWebhook'
                };
                $.ajax({
                    url: '/ajax/device',
                    data: data,
                    type: 'POST',
                    dataType: 'html',
                    success: function (msg) {
                        Swal.fire({
                            title: "Good job!",
                            text: 'Data Berhasil di Update',
                            icon: "success"
                        });
                    },
                    error: function (msg) {
                        Swal.fire({
                            icon: "error",
                            title: "Oops...",
                            text: "Something went wrong!"
                        });
                    }
                });
                // Send AJAX request to save webhook URLs

            });
            $("#autoRead, #typingReply").on("change", function () {
                socket.emit("wa:update-setting", {
                    username,
                    autoRead: $("#autoRead").is(":checked"),
                    typingReply: $("#typingReply").is(":checked")
                })
            })

        })
    </script>

