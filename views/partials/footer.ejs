<script>
    $(document).ready(function() {
        function formatSelect2Option(data) {
            if (!data.id) {
                return data.text;
            }
            var icon = $(data.element).attr('data-icon');
            if (icon) {
                return $('<span><i class="' + icon + '"></i> ' + data.text + '</span>');
            } else {
                return data.text;
            }
        }
            // Inisialisasi Select2 untuk elemen non-modal
            $('.select2').select2();

            // Inisialisasi Select2 untuk elemen dalam modal
            $(".modal").on('shown.bs.modal', function() {
                $(this).find('.select2').select2({
                    templateSelection: formatSelect2Option,
                    templateResult: formatSelect2Option,
                    dropdownParent: $(this)
                });
            });
        });
</script>
