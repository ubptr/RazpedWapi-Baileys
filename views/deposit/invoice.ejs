    <script>
        $('#showForm').hide();
        document.addEventListener('DOMContentLoaded', function () {
            const methodButtons = document.querySelectorAll('[data-type]');
            const channelContainer = document.getElementById('channelpembayaran');

            // Fungsi untuk mengambil channel pembayaran dari API
            function fetchPaymentChannels(paymentType) {
                fetch(`/ajax/payment-channels?type=${paymentType}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.error) {
                            console.error(data.error);
                            return;
                        }
                        updateChannels(data);  // Update tampilan dengan data yang diterima
                    })
                    .catch(error => {
                        console.error('Error fetching payment channels:', error);
                    });
            }
            // fetchPaymentChannels('Bank');
            // Fungsi untuk mengupdate tampilan channel pembayaran
            function updateChannels(channels) {
                channelContainer.innerHTML = '';  // Kosongkan kontainer sebelum menambah channel baru
                $('#showForm').show();
                channels.forEach(channel => {
                    const channelElement = document.createElement('div');
                    channelElement.classList.add('col-12', 'col-lg-6', 'col-xl-4');
                    channelElement.innerHTML = `
                                                <div class="payment-menu h-100">
                                                    <input id="${channel.id}" name="method" type="radio" class="form-check-input"
                                                        value="${channel.id}">
                                                    <label class="payment-item h-100" for="${channel.id}">
                                                        <div class="info-top">
                                                            <div>
                                                                <img src="/library/media/icon/payment/02/${channel.img}" alt="${channel.provider}" width="80">
                                                            </div>
                                                        </div>
                                                        <div class="info-bottom text-sm-left">
                                                            <span class="fw-bolder">${channel.payment}</span>
                                                            <div class="">${channel.note}</div>
                                                        </div>
                                                    </label>
                                                </div>`;
                    channelContainer.appendChild(channelElement);
                });
            }

            // Menambahkan event listener untuk setiap tombol jenis pembayaran
            methodButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const paymentType = button.getAttribute('data-type');
                    fetchPaymentChannels(paymentType);  // Ambil data channel dari server berdasarkan jenis pembayaran
                });
            });
        });
    </script>
